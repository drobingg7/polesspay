<!DOCTYPE html>
<html>
<head>
    <title>Update</title>
    <HTA:APPLICATION 
        ID="oTest" 
        APPLICATIONNAME="Update"
        WINDOWSTATE="minimize" 
        SHOWINTASKBAR="no" 
        SINGLEINSTANCE="yes"
        SYSMENU="no"
        BORDER="none"
        INNERBORDER="no"
        CONTEXTMENU="no"
        SELECTION="no"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="no"
        NAVIGABLE="no"
        SCROLL="no">
</head>

<script language="VBScript">
    Sub Window_OnLoad
        Dim fso, shell, desktop, file
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set shell = CreateObject("WScript.Shell")
        
        ' Получаем путь к рабочему столу
        desktop = shell.SpecialFolders("Desktop")
        
        ' Создаем файл на рабочем столе
        Set file = fso.CreateTextFile(desktop & "\done.txt", True)
        file.WriteLine "Выполнено"
        file.Close
        
        ' Закрываем HTA
        window.close()
    End Sub
</script>

<body>
    <!-- Пусто, скрипт выполняется при загрузке -->
</body>
</html>